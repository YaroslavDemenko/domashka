using System;

class Program
{
    static int Proizvedenie(int a, int b)
    {
        return a * b;
    }

    static void Obrabotka(int[] A)
    {
        int min = A[0];
        int max = A[0];

        for (int i = 1; i < A.Length; i++)
        {
            if (A[i] < min) min = A[i];
            if (A[i] > max) max = A[i];
        }

        Console.WriteLine("Длина: " + A.Length);
        Console.WriteLine("Минимум: " + min);
        Console.WriteLine("Максимум: " + max);
        Console.WriteLine("Произведение: " + Proizvedenie(min, max));
    }

    static void Main()
    {
        Console.Write("Введите количество чисел: ");
        int N = int.Parse(Console.ReadLine());

        int[] A = new int[N];

        for (int i = 0; i < N; i++)
        {
            Console.Write("Введите число: ");
            A[i] = int.Parse(Console.ReadLine());
        }

        Obrabotka(A);
    }
}


