
class Tarakan
{
    public string Name;
    public string Color;
    public int MaxSpeed;
    public int Endurance;
    public int Trainings = 0;

    Random random = new Random();

    public Tarakan(string name, string color, int speed, int endurance)
    {
        Name = name;
        Color = color;
        MaxSpeed = random.Next(0, speed + 1);
        Endurance = endurance;
    }

    public int Dvizhenie()
    {
        int speed = MaxSpeed + Endurance / 10;

        if (speed > 100)
            speed = 100;

        return speed;
    }

    public bool Trenirovka()
    {
        if (Trainings >= 3)
        {
            Console.WriteLine("Больше тренироваться нельзя!");
            return true;
        }

        Trainings++;

        if (random.Next(1, 5) == 1)
        {
            Console.WriteLine("Таракан погиб во время тренировки!");
            return false;
        }

        Console.WriteLine("1. Увеличить максимальную скорость");
        Console.WriteLine("2. Увеличить выносливость");

        int choice = int.Parse(Console.ReadLine());

        if (choice == 1)
            MaxSpeed = Math.Min(100, MaxSpeed * 120 / 100);
        else if (choice == 2)
            Endurance = Endurance * 120 / 100;

        Console.WriteLine("Тренировка завершена!");
        return true;
    }
}

class Totalizator
{
    public int Schet = 1000;
    public int Stavka;

    List<Tarakan> tarakany = new List<Tarakan>();

    public void Dobavit()
    {
        Console.Write("Введите имя таракана: ");
        string name = Console.ReadLine();

        string[] cveta =
        {
            "красный", "Красный",
            "синий", "Синий",
            "зелёный", "Зелёный",
            "жёлтый", "Жёлтый",
            "желтый", "Желтый",
            "чёрный", "Чёрный",
            "черный", "Черный",
            "белый", "Белый",
            "коричневый", "Коричневый",
            "оранжевый", "Оранжевый",
            "фиолетовый", "Фиолетовый",
            "розовый", "Розовый",
            "серый", "Серый",
            "голубой", "Голубой",
            "бирюзовый", "Бирюзовый"
        };

        string color;

        do
        {
            Console.Write("Введите цвет таракана: ");
            color = Console.ReadLine().Trim();

            if (!Array.Exists(cveta, c => c == color))
                Console.WriteLine("Такого цвета нет в списке. Попробуйте ещё раз.");

        } while (!Array.Exists(cveta, c => c == color));

        int speed;
        do
        {
            Console.Write("Введите максимальную скорость (0-100): ");
            speed = int.Parse(Console.ReadLine());
        }
        while (speed < 0 || speed > 100);

        int endurance;
        do
        {
            Console.Write("Введите выносливость (от 0): ");
            endurance = int.Parse(Console.ReadLine());
        }
        while (endurance < 0);

        tarakany.Add(new Tarakan(name, color, speed, endurance));

        Console.WriteLine("Таракан добавлен!");
    }

    public void Udalit()
    {
        Pokazat();

        if (tarakany.Count == 0)
            return;

        Console.Write("Введите номер таракана для удаления: ");
        int number = int.Parse(Console.ReadLine());

        if (number >= 1 && number <= tarakany.Count)
        {
            tarakany.RemoveAt(number - 1);
            Console.WriteLine("Таракан удалён!");
        }
        else
            Console.WriteLine("Неверный номер!");
    }

    public void Pokazat()
    {
        if (tarakany.Count == 0)
        {
            Console.WriteLine("Тараканов пока нет.");
            return;
        }

        for (int i = 0; i < tarakany.Count; i++)
        {
            Console.WriteLine(
                (i + 1) + ". Имя: " + tarakany[i].Name +
                ", цвет: " + tarakany[i].Color +
                ", скорость: " + tarakany[i].MaxSpeed +
                ", выносливость: " + tarakany[i].Endurance);
        }
    }

    public void Trenirovat()
    {
        Pokazat();

        if (tarakany.Count == 0)
            return;

        Console.Write("Введите номер таракана: ");
        int number = int.Parse(Console.ReadLine());

        if (number < 1 || number > tarakany.Count)
        {
            Console.WriteLine("Неверный номер!");
            return;
        }

        if (!tarakany[number - 1].Trenirovka())
            tarakany.RemoveAt(number - 1);
    }

    public void Gonka()
    {
        if (tarakany.Count < 2)
        {
            Console.WriteLine("Для гонки нужно минимум 2 таракана!");
            return;
        }

        Pokazat();

        Console.Write("Введите номер таракана, на которого ставите: ");
        int number = int.Parse(Console.ReadLine());

        if (number < 1 || number > tarakany.Count)
        {
            Console.WriteLine("Неверный номер!");
            return;
        }

        Console.Write("Введите размер ставки: ");
        Stavka = int.Parse(Console.ReadLine());

        if (Stavka <= 0 || Stavka > Schet)
        {
            Console.WriteLine("Неверная ставка!");
            return;
        }

        int winner = 0;
        int maxSpeed = -1;

        Console.WriteLine("\nРезультаты гонки:");

        for (int i = 0; i < tarakany.Count; i++)
        {
            int speed = tarakany[i].Dvizhenie();

            Console.WriteLine(
                tarakany[i].Name + ": скорость " + speed);

            if (speed > maxSpeed)
            {
                maxSpeed = speed;
                winner = i;
            }
        }

        Console.WriteLine("Победитель: " + tarakany[winner].Name);

        if (number - 1 == winner)
        {
            Schet += Stavka * tarakany.Count;
            Console.WriteLine("Вы выиграли!");
        }
        else
        {
            Schet -= Stavka;
            Console.WriteLine("Вы проиграли!");
        }
    }

    public void PokazatSchet()
    {
        Console.WriteLine("Ваш счёт: " + Schet + " рублей");
    }
}

class Program
{
    static void Main()
    {
        Totalizator totalizator = new Totalizator();

        while (true)
        {
            Console.WriteLine("\nМеню:");
            Console.WriteLine("1. Добавить таракана");
            Console.WriteLine("2. Удалить таракана");
            Console.WriteLine("3. Показать всех тараканов");
            Console.WriteLine("4. Потренировать таракана");
            Console.WriteLine("5. Сделать ставку и запустить гонку");
            Console.WriteLine("6. Посмотреть состояние счёта");
            Console.WriteLine("7. Выход");
            Console.Write("Выберите действие: ");

            int choice = int.Parse(Console.ReadLine());

            switch (choice)
            {
                case 1:
                    totalizator.Dobavit();
                    break;
                case 2:
                    totalizator.Udalit();
                    break;
                case 3:
                    totalizator.Pokazat();
                    break;
                case 4:
                    totalizator.Trenirovat();
                    break;
                case 5:
                    totalizator.Gonka();
                    break;
                case 6:
                    totalizator.PokazatSchet();
                    break;
                case 7:
                    return;
                default:
                    Console.WriteLine("Неверный пункт меню!");
                    break;
            }
        }
    }
}
